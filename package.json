{
  "name": "@barzano/pay",
  "version": "0.2.3",
  "description": "SDK oficial TypeScript para a API da Barzano Pay",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "barzano": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandonicolau/barzano-pay-node.git"
  },
  "homepage": "https://pay.barzano.com.br/docs",
  "bugs": {
    "url": "https://github.com/fernandonicolau/barzano-pay-node/issues"
  },
  "keywords": [
    "barzano",
    "payments",
    "pix",
    "pagbank",
    "typescript",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.18.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
